# ============================================================
# auton-agent — environment template
# Copy to .env and fill in. NEVER commit the filled .env.
# ============================================================

# ------------------------------------------------------------
# MODEL PROVIDER  (Ollama Cloud — no self-hosted LLM)
# ------------------------------------------------------------
# The primary model was chosen by probing the account's real entitlement, not by
# picking a recognisable name: gpt-oss:120b is the largest model this account can
# actually reach that also supports tool calling. Every fallback below is a model
# that was verified to answer. If a key with higher entitlement is used, point
# MODEL_PRIMARY at a stronger model -- no code change is needed.
MODEL_PROVIDER=ollama_cloud
OLLAMA_BASE_URL=https://ollama.com
MODEL_PRIMARY=gpt-oss:120b
MODEL_FALLBACKS=nemotron-3-ultra,gpt-oss:20b,nemotron-3-nano:30b,nemotron-3-super,gemma4:31b
MODEL_TIMEOUT_SECONDS=240
MODEL_MAX_RETRIES=3
MODEL_TEMPERATURE=0.2

# REQUIRED — from https://ollama.com/settings/keys
OLLAMA_API_KEY=

# ------------------------------------------------------------
# TELEGRAM  (the primary human interface)
# ------------------------------------------------------------
# REQUIRED to enable the bot. Create one with @BotFather.
TELEGRAM_BOT_TOKEN=

# REQUIRED as a security control: only these Telegram user IDs may use the agent.
# Leave empty and every message is denied (the safe default). Get your numeric id
# from @userinfobot.
TELEGRAM_ALLOWED_USERS=

# "webhook" is right for Render: a webhook wakes a spun-down free instance, whereas
# long-polling would need a permanently running process. Use "poll" for local dev.
TELEGRAM_MODE=webhook

# Optional but recommended: a shared secret Telegram echoes back on every webhook
# call, so forged requests are rejected. Any random string.
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_MAX_REQUESTS_PER_MINUTE=6

# ------------------------------------------------------------
# PERSISTENT STATE  (survives redeploys on an ephemeral filesystem)
# ------------------------------------------------------------
# "chained" = local disk for speed + private GitHub Gist as the durable mirror.
# "disk"    = local only (state is LOST on redeploy — not recommended on Render).
# "gist"    = Gist only.
PERSISTENCE_BACKEND=chained

# REQUIRED when PERSISTENCE_BACKEND is gist/chained. Needs the `gist` scope.
# The agent creates and manages the gist itself — do NOT hardcode GIST_ID.
GIST_API_KEY=

# OPTIONAL. Leave blank normally: on first boot the agent finds its own state gist
# (by description marker) or creates one, and caches the id in STATE_ROOT. Set this
# only to re-attach a specific gist after a total wipe.
GIST_ID=

GIST_FILENAME_PREFIX=auton-agent

# ------------------------------------------------------------
# HTTP API  (programmatic access to the agent)
# ------------------------------------------------------------
# REQUIRED to drive the agent over HTTP (POST /tasks, /self, /events).
# Any long random string. Sent as: Authorization: Bearer <value>
API_AUTH_TOKEN=

# ------------------------------------------------------------
# AGENT BEHAVIOUR
# ------------------------------------------------------------
# Iteration and wall-clock ceilings — these are what stop a runaway loop.
AGENT_MAX_STEPS=40
AGENT_MAX_SECONDS=900

# Sent to the model so it can see what it is running on.
AGENT_ENVIRONMENT_NOTE="Render free instance: 0.1 CPU, 512 MB RAM, ephemeral disk, Debian/Linux container."

# ------------------------------------------------------------
# EXECUTION SANDBOX
# ------------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_SECONDS=120
SANDBOX_MAX_OUTPUT_BYTES=200000
SANDBOX_MAX_PROCESSES=128

# Allow destructive commands (rm -rf /, mkfs, reboot) without a per-call approval.
# Keep false unless you genuinely need it.
ALLOW_DESTRUCTIVE=false

# ------------------------------------------------------------
# WORKSPACE / STATE PATHS
# ------------------------------------------------------------
WORKSPACE_ROOT=./workspace
STATE_ROOT=./.agentstate

# Extra directories to scan for skill files (colon-separated).
SKILLS_PATH=

LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------
# RENDER  (deployment only — not needed by the running agent)
# ------------------------------------------------------------
RENDER_API_KEY_1=
RENDER_API_KEY_2=

# ------------------------------------------------------------
# GITHUB  (repo push + gist management)
# ------------------------------------------------------------
GITHUB_API_KEY=
GITHUB_USERNAME=
